new file mode 100644
index 0000000..7dca484
--- /dev/null
+++ b/src/demoEvents.js
@@ -0,0 +1,26 @@
+'use strict';
+
+/**
+ * Demo deployment only: tell the demo backend about each created card so the tester sees it
+ * under Results. No-op unless CARD_EVENTS_URL is set; failures never affect the bot.
+ */
+
+const CARD_EVENTS_URL = process.env.CARD_EVENTS_URL || '';
+const BOT_API_TOKEN = process.env.BOT_API_TOKEN || '';
+
+async function reportCard({ slackUserId, title, url }) {
+  if (!CARD_EVENTS_URL) return;
+  try {
+    const res = await fetch(CARD_EVENTS_URL, {
+      method: 'POST',
+      headers: { 'content-type': 'application/json', authorization: `Bearer ${BOT_API_TOKEN}` },
+      body: JSON.stringify({ slack_user_id: slackUserId, title, url }),
+      signal: AbortSignal.timeout(10000),
+    });
+    if (!res.ok) throw new Error(`HTTP ${res.status}`);
+  } catch (e) {
+    console.error('[demoEvents] card event failed:', e.message);
+  }
+}
+
+module.exports = { reportCard };
