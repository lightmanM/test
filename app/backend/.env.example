# Local development settings (copy to app/backend/.env). Never commit real values.
DEMO_PASSCODE=demo
ADMIN_PASSCODE=admin
SESSION_SECRET=change-me-to-a-long-random-string
DEMO_FAKE_PLATFORMS=1
DATABASE_URL=sqlite:///./workflow_demo.db
PUBLIC_BASE_URL=http://localhost:8000
COOKIE_SECURE=false
MAX_USERS=10
DEPLOYMENT_TTL_HOURS=24
# Housekeeping (expiry, abandoned popups, lost jobs, platform orphans); 0 turns it off.
SWEEP_INTERVAL_SECONDS=600
# Only on the one hosted instance that owns the n8n/Make accounts (deletes unreferenced demo items).
ORPHAN_SWEEP=false
# Account connections (P2). Without NANGO_SECRET_KEY, Slack/Google use demo data in fake mode only.
NANGO_SECRET_KEY=
# NANGO_HOST=https://api.nango.dev
# NANGO_CONNECT_URL=https://connect.nango.dev
# Needed to save the Meegle token. Generate your own (32 random bytes, base64):
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Changing it makes saved tokens unreadable (users re-enter them).
DATA_ENCRYPTION_KEY=
# n8n (P3). Leave empty to show n8n workflows as "not set up" (or use DEMO_FAKE_PLATFORMS=1).
N8N_BASE_URL=
N8N_API_KEY=
# n8n calls Google through the demo (which forwards to Nango's proxy): the demo's address as n8n
# reaches it. Without it the uptime monitor and Medium digest show as "not set up".
RELAY_BASE_URL=
# Medium digest: owner-provided LLM key and the reader service (P4).
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
READER_BASE_URL=
READER_API_TOKEN=
# Shared Slack bot on Modal (P4): the same token goes into the bot's Modal secret.
BOT_API_TOKEN=
# SLACK_BOT_TEAM_ID=T0123ABCD   # optional: require testers' Slack connection in the bot's workspace
# Make Bridge (P5); see catalog/github-merge-slack/make-setup.md. Empty → "not set up".
# MAKE_ZONE=us2.make.com
# MAKE_TEAM_ID=
MAKE_BRIDGE_KEY_ID=
MAKE_BRIDGE_SECRET=
MAKE_BRIDGE_TEMPLATE_ID=
