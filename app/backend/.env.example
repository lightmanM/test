# Local development settings (copy to app/backend/.env). Never commit real values.
DEMO_PASSCODE=demo
ADMIN_PASSCODE=admin
SESSION_SECRET=change-me-to-a-long-random-string
DEMO_FAKE_PLATFORMS=1
DATABASE_URL=sqlite:///./workflow_demo.db
PUBLIC_BASE_URL=http://localhost:8000
COOKIE_SECURE=false
MAX_USERS=10
DEPLOYMENT_TTL_HOURS=24
# Account connections (P2). Without NANGO_SECRET_KEY, Slack/Google use demo data in fake mode only.
# NANGO_SECRET_KEY=
# NANGO_HOST=https://api.nango.dev
# 32 random bytes, base64: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Needed to save the Meegle token. Changing it makes saved tokens unreadable (users re-enter them).
DATA_ENCRYPTION_KEY=ZGV2LW9ubHktZGF0YS1lbmNyeXB0aW9uLWtleS0wMDA=
