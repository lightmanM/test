            "mapper": {},
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 0,
                    "name": "Watch Merged PR"
                },
                "restore": {
                    "parameters": {
                        "__IMTCONN__": {
                            "label": "devin GitHub connection"
                        },
                        "choose": {
                            "mode": "chose",
                            "label": "Updated Date"
                        },
                        "owner": {
                            "mode": "chose",
                            "label": "heroliy-sketch"
                        },
                        "name": {
                            "mode": "chose",
                            "label": "auto-workflow"
                        }
                    }
                },
                "parameters": [
                    {
                        "on": {
                            "change": "reset_epoch"
                        },
                        "name": "__IMTCONN__",
                        "type": "account:github2,github",
                        "label": "Connection",
                        "required": true
                    },
                    {
                        "name": "choose",
                        "type": "select",
                        "label": "Watch",
                        "required": true,
                        "validate": {
                            "enum": [
                                "created",
                                "updated"
                            ]
                        }
                    },
                    {
                        "name": "owner",
                        "type": "select",
                        "label": "Owner",
                        "mappable": true,
                        "required": true
                    },
                    {
                        "mode": "edit",
                        "name": "name",
                        "type": "select",
                        "label": "Repository Name",
                        "mappable": true,
                        "required": true
                    },
                    {
                        "name": "limit",
                        "type": "uinteger",
                        "label": "Limit",
                        "default": 2,
                        "required": true
                    },
                    {
                        "name": "pageLimit",
                        "type": "uinteger",
                        "label": "Page size",
                        "default": 100,
                        "advanced": true,
                        "validate": {
                            "max": 100,
                            "min": 10
                        }
                    }
                ]
            }
        },
