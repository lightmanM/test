                "channelWType": "list",
                "channelType": "public",
                "channel": "C0C5E88SKSP",
                "text": "*GitHub 合并提交通知*\n\n*仓库：* heroliy-sketch/auto-workflow\n*PR：* {{1.title}}\n*合并人：* {{1.mergedBy.login}}\n*提交：* {{1.mergeCommit.abbreviatedOid}}\n*链接：* {{1.url}}\n\n*本次提交 Diff：*\n```{{2.body}}```"
            },
            "metadata": {
                "designer": {
                    "x": 600,
                    "y": 0,
                    "name": "Notify Frontend"
                },
                "restore": {
