                                                            },
                                                            {
                                                                "label": "User ID",
                                                                "value": "user",
                                                                "nested": [
                                                                    {
                                                                        "name": "channel",
                                                                        "type": "text",
                                                                        "label": "User (User ID)",
                                                                        "required": true
                                                                    }
                                                                ]
                                                            },
                                                            {
                                                                "label": "Username",
                                                                "value": "username",
                                                                "nested": [
                                                                    {
                                                                        "name": "channel",
                                                                        "type": "text",
                                                                        "label": "User (Username)",
                                                                        "required": true
                                                                    }
                                                                ]
                                                            }
                                                        ]
                                                    },
                                                    "required": true
