# Settings for the hosted demo (service "demo" in deploy/aws/compose.yml). Copy to
# deploy/production.env (git-ignored) and fill in; deploy/aws/deploy.sh copies it to the server.
# Where each value comes from: docs/setup-guide.md. Generate random values with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"                                   (tokens)
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"               (encryption key)

# Access
DEMO_PASSCODE=
ADMIN_PASSCODE=
SESSION_SECRET=
MAX_USERS=10
DEPLOYMENT_TTL_HOURS=24
PUBLIC_BASE_URL=https://demo-<ip-with-dashes>.sslip.io
# The Postgres container on the server; the password is DEMO_DB_PASSWORD in deploy/aws/.env.
DATABASE_URL=postgresql://demo:<DEMO_DB_PASSWORD>@postgres:5432/workflow_demo

# This instance owns the platform accounts: let the sweeper remove unreferenced demo items.
ORPHAN_SWEEP=true

# Workflows switched off on this server (testers see the catalog's unavailable_note).
# GitHub merge → Slack: Make discontinued Bridge (docs/progress.md, decision log).
DISABLED_WORKFLOWS=github-merge-slack

# Connections
NANGO_SECRET_KEY=
DATA_ENCRYPTION_KEY=

# n8n + Google (+ Medium digest)
# n8n on the same server (internal address); deploy/aws/setup_n8n.py creates the API key.
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# The Medium reader container (internal address); the token must equal READER_API_TOKEN in deploy/aws/.env.
READER_BASE_URL=http://reader:8000
READER_API_TOKEN=

# Make Bridge
MAKE_ZONE=us2.make.com
# MAKE_TEAM_ID=
MAKE_BRIDGE_KEY_ID=
MAKE_BRIDGE_SECRET=
MAKE_BRIDGE_TEMPLATE_ID=

# Shared Slack bot (the same token goes into deploy/aws/bot.env)
BOT_API_TOKEN=
# SLACK_BOT_TEAM_ID=
