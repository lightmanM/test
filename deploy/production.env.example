# Settings for the hosted demo (Modal secret "workflow-demo-app"). Copy to deploy/production.env
# (git-ignored), fill in, then: modal secret create workflow-demo-app --from-dotenv deploy/production.env
# Where each value comes from: docs/setup-guide.md. Generate random values with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"                                   (tokens)
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"               (encryption key)

# Access
DEMO_PASSCODE=
ADMIN_PASSCODE=
SESSION_SECRET=
MAX_USERS=10
DEPLOYMENT_TTL_HOURS=24
PUBLIC_BASE_URL=https://<workspace>--workflow-demo-web.modal.run
# Neon: the pooled URL for the app; the direct (non-pooled) one for schema migrations.
DATABASE_URL=postgresql://...-pooler...neon.tech/...?sslmode=require
MIGRATION_DATABASE_URL=postgresql://...neon.tech/...?sslmode=require

# This instance owns the platform accounts: let the sweeper remove unreferenced demo items.
ORPHAN_SWEEP=true

# Connections
NANGO_SECRET_KEY=
DATA_ENCRYPTION_KEY=

# n8n + Google (+ Medium digest)
N8N_BASE_URL=https://<team>.app.n8n.cloud
N8N_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
READER_BASE_URL=https://<workspace>--workflow-demo-medium-reader-reader.modal.run
READER_API_TOKEN=

# Make Bridge
MAKE_ZONE=us2.make.com
# MAKE_TEAM_ID=
MAKE_BRIDGE_KEY_ID=
MAKE_BRIDGE_SECRET=
MAKE_BRIDGE_TEMPLATE_ID=

# Shared Slack bot (same token in the bot's Modal secret)
BOT_API_TOKEN=
# SLACK_BOT_TEAM_ID=
