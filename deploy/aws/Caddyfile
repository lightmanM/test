# The two public hostnames (sslip.io names of the server's IP, so no DNS setup is needed).
# Caddy gets and renews their HTTPS certificates itself.

{$DEMO_HOST} {
	encode zstd gzip
	# n8n reaches the demo's Google relay over the internal network (RELAY_BASE_URL=http://demo:8000),
	# so it isn't offered on the public address: the relay doesn't check where a call comes from, and
	# this keeps a leaked deployment key from being usable outside the server.
	@relay path /api/google-relay /api/google-relay/*
	respond @relay 404
	reverse_proxy demo:8000
}

{$N8N_HOST} {
	# The demo reaches n8n over the internal network; this public editor is only for the owner. Only
	# the machine that ran deploy.sh (ADMIN_IP) gets through, so nobody else can claim a fresh
	# instance before setup_n8n.py runs. The whole host is restricted rather than single paths:
	# n8n's router also accepts other spellings of a path (case, trailing slash) than Caddy's matcher.
	@outsider not remote_ip {$ADMIN_IP:127.0.0.1}
	respond @outsider 403
	reverse_proxy n8n:5678
}
