# The Slack → Meegle bot (service "bot" in compose.yml). Copy to deploy/aws/bot.env (git-ignored).
# Slack and Meegle values: setup guide §2 and §9 (the same names as the team's
# demo-project/slark-meegle-bot/.env; its other MEEGLE_* values can be added too).
# USER_MAP_URL and CARD_EVENTS_URL are set in compose.yml.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
MEEGLE_PLUGIN_ID=
MEEGLE_PLUGIN_SECRET=
MEEGLE_PROJECT_KEY=
MEEGLE_SIMPLE_NAME=
MEEGLE_WORK_ITEM_TYPE_KEY=
MEEGLE_USER_KEY=
# MEEGLE_ROLE_KEY=

# Must equal BOT_API_TOKEN in deploy/production.env (deploy.sh checks).
BOT_API_TOKEN=
