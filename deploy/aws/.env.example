# Infrastructure settings for deploy/aws/compose.yml. Copy to deploy/aws/.env (git-ignored).
# Random values: python3 -c "import secrets;print(secrets.token_urlsafe(32))"

# The server: provision.sh prints these. The hostnames are sslip.io names of the IP.
SERVER_IP=
DEMO_HOST=demo-<ip-with-dashes>.sslip.io
N8N_HOST=n8n-<ip-with-dashes>.sslip.io

# Postgres: the superuser and one user per database (the demo's goes into DATABASE_URL in
# deploy/production.env). They are set when the database volume is first created; changing them
# later needs `ALTER USER <name> PASSWORD '...'` in the postgres container as well.
POSTGRES_PASSWORD=
DEMO_DB_PASSWORD=
N8N_DB_PASSWORD=

# n8n. N8N_ENCRYPTION_KEY encrypts the credentials stored in n8n: keep it stable.
N8N_VERSION=2.41.6
N8N_ENCRYPTION_KEY=
N8N_RUNNERS_AUTH_TOKEN=
TIMEZONE=America/Los_Angeles

# Medium reader. Must equal READER_API_TOKEN in deploy/production.env (deploy.sh checks).
READER_API_TOKEN=
# FREEDIUM_BASE_URL=https://freedium-mirror.cfd
